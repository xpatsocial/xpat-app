# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Sentry
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# PostHog
EXPO_PUBLIC_POSTHOG_KEY=your-posthog-api-key
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Maps (Android only — iOS uses Apple Maps)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Build flags (set in eas.json, override here for local builds)
SENTRY_DISABLE_AUTO_UPLOAD=true
